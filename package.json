{
  "name": "automationexercise-playwright",
  "version": "1.0.0",
  "description": "Automation Exercise Ecommerce Frontend (Playwright + TypeScript + POM + Fixtures)",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:chrome": "playwright test --project=chrome",
    "test:smoke": "playwright test --project=chrome --grep \"@smoke\"",
    "test:regression": "playwright test --project=chrome --grep \"@regression\" --grep-invert \"@smoke\"",
    "test:regression:mobile": "playwright test --project=mobile-chrome --grep \"(?:@regression|Visual regression)\" --grep-invert \"@smoke\"",
    "test:regression:mobile-safari": "playwright test --config=playwright.mobile-safari.config.ts --grep \"@regression\" --grep-invert \"@smoke\"",
    "test:checkout": "playwright test --workers=1 tests/06-checkout-e2e.spec.ts",
    "test:a11y": "playwright test --project=chrome --workers=1 --grep \"@a11y\"",
    "test:visual": "playwright test --project=chrome --project=mobile-chrome -g \"Visual regression\"",
    "test:visual:update": "playwright test --project=chrome --project=mobile-chrome -g \"Visual regression\" --update-snapshots",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "typecheck": "tsc --noEmit",
    "report:a11y": "node scripts/show-accessibility-report.cjs",
    "report": "node scripts/show-latest-report.cjs",
    "codegen": "playwright codegen https://automationexercise.com"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "dotenv": "^18.0.8"
  }
}
